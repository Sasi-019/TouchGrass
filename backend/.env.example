# ---------------------------------------------------------------
# TouchGrass backend configuration
# Copy this file to  backend/.env  and fill in the values.
# NEVER commit the real .env file (it is already in .gitignore).
# ---------------------------------------------------------------

# "development" or "production"
APP_ENV=development

# PostgreSQL connection string.
# Local example:  postgresql://postgres:YOUR_PASSWORD@localhost:5432/touchgrass
# Render/Railway/Neon give you a URL; "postgres://..." is accepted too.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/touchgrass

# Secret used to sign login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256
# Minutes a login lasts (1440 = 24 hours).
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Groq API key (https://console.groq.com/keys)
GROQ_API_KEY=
# Reasoning model for the agent and speech-to-text model for voice input.
GROQ_MODEL=openai/gpt-oss-20b
WHISPER_MODEL=whisper-large-v3-turbo
# Largest voice recording accepted, in megabytes.
MAX_AUDIO_MB=20

# Frontend URL(s) allowed to call this API (comma separated, no trailing slash).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional: also allow Vercel preview deployments.
# CORS_ORIGIN_REGEX=https://touchgrass-.*\.vercel\.app

# Optional overrides for the free OpenStreetMap services.
# OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter
# HTTP_USER_AGENT=TouchGrass/1.0 (contact: you@example.com)

# Set to true to print every SQL statement while debugging.
SQL_ECHO=false
